@model Project.Models.Feedback
@{
    ViewBag.Title = "Leave a Review";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width:540px; margin:0 auto;">
    <div class="form-card">
        <h2>⭐ Review: @ViewBag.BookTitle</h2>

        @Html.ValidationSummary(true, "",
            new { @class = "validation-summary-errors" })

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.BookId)

            <div class="form-group">
                @Html.LabelFor(m => m.Rating)
                @Html.DropDownListFor(m => m.Rating,
                    new SelectList(new[]
                    {
                        new { Value = 5, Text = "★★★★★  Excellent (5)" },
                        new { Value = 4, Text = "★★★★☆  Very Good (4)" },
                        new { Value = 3, Text = "★★★☆☆  Good (3)" },
                        new { Value = 2, Text = "★★☆☆☆  Fair (2)" },
                        new { Value = 1, Text = "★☆☆☆☆  Poor (1)" }
                    }, "Value", "Text", Model.Rating),
                    new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Rating, "",
                    new { @class = "field-validation-error" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Comment)
                @Html.TextAreaFor(m => m.Comment,
                    new
                         {
                             @class = "form-control",
                          rows = "5",
                          placeholder = "Write your thoughts about this book..."
                         })
                @Html.ValidationMessageFor(m => m.Comment, "",
                    new { @class = "field-validation-error" })
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-success">
                    Submit Review
                </button>
                @Html.ActionLink("Cancel", "Details", "Books",
                    new { id = ViewBag.BookId },
                    new { @class = "btn btn-secondary" })
            </div>
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}