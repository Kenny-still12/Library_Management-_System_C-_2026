@model IEnumerable<Project.Models.Member>
@{
    ViewBag.Title = "Most Active Members";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header">
    <h2>👥 Most Active Members</h2>
    @Html.ActionLink("← Back to Reports", "Index", null,
        new { @class = "btn btn-secondary" })
</div>

<div class="table-wrapper">
    <table class="data-table">
        <thead>
            <tr>
                <th>Rank</th>
                <th>Member</th>
                <th>Email</th>
                <th>Member Since</th>
                <th>Total Borrowings</th>
            </tr>
        </thead>
        <tbody>
            @{int rank = 1;}
            @foreach (var m in Model)
            {
                <tr>
                    <td><strong>#@rank</strong></td>
                    <td><strong>@m.FullName</strong></td>
                    <td>@m.Email</td>
                    <td>@m.MembershipDate.ToShortDateString()</td>
                    <td>
                        <span class="badge badge-info">
                            @(m.BorrowingTransactions != null
                                ? m.BorrowingTransactions.Count
                                : 0) loans
                        </span>
                    </td>
                </tr>
                rank++;
            }
        </tbody>
    </table>
</div>