@model Project.Models.LoginViewModel
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width:440px; margin:40px auto;">
    <div class="form-card">
        <h2>🔐 Login</h2>

        @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

        @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl },
                FormMethod.Post, new { @class = "" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                @Html.LabelFor(m => m.Email)
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "your@email.com" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Password)
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "••••••" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
            </div>

            <div class="form-group">
                <label>
                    @Html.CheckBoxFor(m => m.RememberMe)
                    Remember me
                </label>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%; padding:11px;">
                Login
            </button>
        }

        <p style="text-align:center; margin-top:20px; color:#6b7280; font-size:0.9rem;">
            Don't have an account?
            @Html.ActionLink("Register here", "Register", "Account",
                null, new { style = "color:#1e3a8a; font-weight:600;" })
        </p>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}